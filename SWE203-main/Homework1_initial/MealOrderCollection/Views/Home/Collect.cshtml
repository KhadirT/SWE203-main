@model CollectMealViewModel

@{
    ViewData["Title"] = "Collect a Meal";
}

<h1>Collect a Meal</h1>

<form asp-action="Collect" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All"></div>
    <label asp-for="OrderID">Order ID</label>
    <input asp-for="OrderID" />
    <button type="submit">Collect Meal</button>
</form>

@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <p>@Model.Message</p>
}

<p><a asp-action="Index">Back to Home</a></p>